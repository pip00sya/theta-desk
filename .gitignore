.env
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
data/thetadesk.sqlite
data/evidence/
data/demo/
data/alerts.log
# journal + snapshots ARE committed: reconcile and replay need them
!data/journal/
!data/snapshots/
# raw tick snapshots stay local; the repo carries the gzipped form
# (tools/publish_prep.py), which tools/replay.py reads transparently
data/snapshots/*.json
!data/snapshots/*.json.gz
data/tick.log
submission/_video/
data/notes/*.digest
data/notes/*.published
data/watchdog.log
data/journal/*.lock
data/keepalive.log

# competitor demo videos pulled for design research: 273MB, not ours to ship
research/vid/
# a stray empty store created by a mis-set path
data/state.sqlite

# the pulse writes constantly; its log and pid are machine-local
data/pulse.jsonl
data/pulse.pid
data/pulse.err
data/pulse.out
