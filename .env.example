# Copy to .env and fill. NEVER commit .env.
# Paper endpoint is MANDATORY — the process refuses to start without it.
APCA_API_BASE_URL=https://paper-api.alpaca.markets
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER_TRADE=true

# LLM roles (optional — desk degrades to deterministic core without them)
ANTHROPIC_API_KEY=
FEATHERLESS_API_KEY=

# Alerts (optional — DEVLOG #21). Every alert is always written to
# data/alerts.log and the journal; set one of these to also get pushed.
# Telegram: create a bot with @BotFather, message it once, read your chat id
# from https://api.telegram.org/bot<TOKEN>/getUpdates
ALERT_TELEGRAM_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
ALERT_WEBHOOK_URL=
